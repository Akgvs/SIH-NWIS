# Environment — copy to .env and fill in values
DATABASE_URL=postgresql://postgres:password@localhost:5432/nwis_db
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Alert Thresholds (configurable)
ALERT_TORQUE_THRESHOLD=95
ALERT_ECD_THRESHOLD=1.25
ALERT_ROP_DROP_THRESHOLD=30
ALERT_DEPTH_WINDOW=50

# Simulation settings
SIMULATION_INTERVAL_MS=2000
SIMULATION_DEPTH_INCREMENT=5
SIMULATION_START_DEPTH=2800
SIMULATION_END_DEPTH=3200
